{
  "name": "oxygen-aiagent",
  "displayName": "Oxygen — Token Saver",
  "description": "Professional token saver for AI Agents — skeletons, compression, workspace indexing, and savings tracking.",
  "icon": "icon.png",
  "version": "1.0.8",
  "publisher": "oxygen",
  "author": {
    "name": "Harith Riad Hassan & Rafea Read Hussein"
  },
  "contributors": [
    "Harith Riad Hassan",
    "Rafea Read Hussein"
  ],
  "license": "MIT",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "tokens",
    "cursor",
    "copilot",
    "context",
    "skeleton",
    "compression",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oxygen",
          "title": "Oxygen",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "oxygen": [
        {
          "type": "webview",
          "id": "oxygen.activationView",
          "name": "Activation",
          "icon": "icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "oxygen.enterLicense",
        "title": "Oxygen: Enter / Renew License"
      },
      {
        "command": "oxygen.showLog",
        "title": "Oxygen: Show Log"
      },
      {
        "command": "oxygen.copySkeleton",
        "title": "Oxygen: Copy File Skeleton"
      },
      {
        "command": "oxygen.copyContextBundle",
        "title": "Oxygen: Copy Context Bundle"
      },
      {
        "command": "oxygen.purifySelection",
        "title": "Oxygen: Minify Selection"
      },
      {
        "command": "oxygen.indexWorkspace",
        "title": "Oxygen: Index Workspace"
      },
      {
        "command": "oxygen.generateSkeleton",
        "title": "Oxygen: Cache Skeleton"
      },
      {
        "command": "oxygen.applyScope",
        "title": "Oxygen: Save Focus Scope"
      },
      {
        "command": "oxygen.copySessionSummary",
        "title": "Oxygen: Copy Session Summary"
      },
      {
        "command": "oxygen.resetSession",
        "title": "Oxygen: Reset Session Counter"
      }
    ],
    "configuration": {
      "title": "Oxygen Token Saver",
      "properties": {
        "oxygen.licenseKey": {
          "type": "string",
          "default": "",
          "description": "Time-bound AES license key. Extension stays locked until a valid key is entered."
        },
        "oxygen.ui.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show token savings in the status bar (bottom-left)."
        },
        "oxygen.pricing.preset": {
          "type": "string",
          "default": "composer",
          "enum": [
            "composer",
            "gpt4o",
            "gpt4oMini",
            "claudeSonnet",
            "claudeHaiku",
            "geminiFlash",
            "deepseek",
            "custom"
          ],
          "description": "Pricing preset for savings display."
        },
        "oxygen.pricing.inputPerMillion": {
          "type": "number",
          "default": 1.25,
          "description": "Custom USD per 1M input tokens (preset=custom)."
        },
        "oxygen.pricing.outputPerMillion": {
          "type": "number",
          "default": 6,
          "description": "Custom USD per 1M output tokens (preset=custom)."
        },
        "oxygen.skeleton.autoCache": {
          "type": "boolean",
          "default": true,
          "description": "Auto-cache skeletons in .oxygen/skeletons/ while editing."
        },
        "oxygen.scope.autoApply": {
          "type": "boolean",
          "default": true,
          "description": "Auto-save focus scope to .oxygen/context-scope.json (does not modify .cursorignore)."
        },
        "oxygen.scope.depth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 6,
          "description": "Parent folders included in allowed scope."
        },
        "oxygen.tokens.autoIndexOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Auto-index workspace on open — caches skeletons, updates status bar, writes .oxygen/project-map.md (no need to open files manually)."
        },
        "oxygen.tokens.watchFiles": {
          "type": "boolean",
          "default": true,
          "description": "Auto-update savings when workspace files are created or changed on disk."
        },
        "oxygen.tokens.largeFileWarning": {
          "type": "number",
          "default": 4000,
          "description": "Warn in status bar when active file exceeds this many tokens."
        },
        "oxygen.session.autoSummary": {
          "type": "boolean",
          "default": true,
          "description": "Auto-write .oxygen/session-summary.md."
        },
        "oxygen.session.summaryIntervalMinutes": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 60,
          "description": "Session summary refresh interval."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test:unit": "node test/unit.smoke.js",
    "install:cursor": "node scripts/install-to-cursor.js",
    "license:generate": "node scripts/generate-license.js",
    "package:vsix": "vsce package"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "globals": "^16.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  }
}
