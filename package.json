{
  "name": "oxygen-aiagent",
  "displayName": "Oxygen — Token Saver",
  "description": "موفر توكن احترافي للـ AI Agent — skeletons، ضغط، فهرسة، وتتبع التوفير",
  "version": "1.0.1",
  "publisher": "oxygen",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "tokens",
    "cursor",
    "copilot",
    "context",
    "skeleton",
    "compression",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "oxygen.showLog",
        "title": "Oxygen: Show Log"
      },
      {
        "command": "oxygen.copySkeleton",
        "title": "Oxygen: Copy File Skeleton"
      },
      {
        "command": "oxygen.copyContextBundle",
        "title": "Oxygen: Copy Context Bundle"
      },
      {
        "command": "oxygen.purifySelection",
        "title": "Oxygen: Minify Selection"
      },
      {
        "command": "oxygen.indexWorkspace",
        "title": "Oxygen: Index Workspace"
      },
      {
        "command": "oxygen.generateSkeleton",
        "title": "Oxygen: Cache Skeleton"
      },
      {
        "command": "oxygen.applyScope",
        "title": "Oxygen: Save Focus Scope"
      },
      {
        "command": "oxygen.copySessionSummary",
        "title": "Oxygen: Copy Session Summary"
      }
    ],
    "configuration": {
      "title": "Oxygen Token Saver",
      "properties": {
        "oxygen.ui.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show token savings in the status bar (bottom-right)."
        },
        "oxygen.pricing.preset": {
          "type": "string",
          "default": "composer",
          "enum": [
            "composer",
            "gpt4o",
            "gpt4oMini",
            "claudeSonnet",
            "claudeHaiku",
            "geminiFlash",
            "deepseek",
            "custom"
          ],
          "description": "Pricing preset for savings display."
        },
        "oxygen.pricing.inputPerMillion": {
          "type": "number",
          "default": 1.25,
          "description": "Custom USD per 1M input tokens (preset=custom)."
        },
        "oxygen.pricing.outputPerMillion": {
          "type": "number",
          "default": 6.0,
          "description": "Custom USD per 1M output tokens (preset=custom)."
        },
        "oxygen.skeleton.autoCache": {
          "type": "boolean",
          "default": true,
          "description": "Auto-cache skeletons in .oxygen/skeletons/ while editing."
        },
        "oxygen.scope.autoApply": {
          "type": "boolean",
          "default": true,
          "description": "Auto-save focus scope to .oxygen/context-scope.json (does not modify .cursorignore)."
        },
        "oxygen.scope.depth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 6,
          "description": "Parent folders included in allowed scope."
        },
        "oxygen.tokens.autoIndexOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Index workspace skeletons on open (writes .oxygen/project-map.md)."
        },
        "oxygen.tokens.largeFileWarning": {
          "type": "number",
          "default": 4000,
          "description": "Warn in status bar when active file exceeds this many tokens."
        },
        "oxygen.session.autoSummary": {
          "type": "boolean",
          "default": true,
          "description": "Auto-write .oxygen/session-summary.md."
        },
        "oxygen.session.summaryIntervalMinutes": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 60,
          "description": "Session summary refresh interval."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test:unit": "node test/unit.smoke.js",
    "install:cursor": "node scripts/install-to-cursor.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
